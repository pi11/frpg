# /etc/wasteland/deploy.env — root:root, mode 600. Read by deploy.sh.
# Migrations go straight to PostgreSQL, past PgBouncer.
MIGRATION_DATABASE_URL=postgresql+asyncpg://wasteland:CHANGE_ME@127.0.0.1:5432/wasteland
# Shown publicly in /privacy and /delete-account.
VITE_CONTACT_EMAIL=
VITE_OPERATOR=
VITE_BACKUP_DAYS=14
