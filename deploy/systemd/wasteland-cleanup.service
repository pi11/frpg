[Unit]
Description=Wasteland: delete inactive guests and stale login data
After=postgresql.service pgbouncer.service

[Service]
Type=oneshot
User=wasteland
Group=wasteland
WorkingDirectory=/srv/wasteland/app/server
EnvironmentFile=/etc/wasteland/wasteland.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/wasteland/app/server/.venv/bin/python -m app.services.cleanup
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
