# /etc/wasteland/wasteland.env — root:wasteland, mode 640. Read by systemd, not by a shell.
# PostgreSQL directly; 6432 instead of 5432 if you go through PgBouncer (transaction pooling).
DATABASE_URL=postgresql+asyncpg://wasteland:CHANGE_ME@127.0.0.1:5432/wasteland
# Local port of the API; the same one in /etc/nginx/snippets/wasteland-proxy.conf.
API_PORT=8010
PUBLIC_URL=https://wasteland.lol
CORS_ORIGINS='["https://wasteland.lol","https://localhost"]'
JWT_SECRET=
# resend, or disabled to hide sign-in by mail.
MAIL_BACKEND=resend
RESEND_API_KEY=
MAIL_FROM="Пустошь <login@wasteland.lol>"
# Leave all three empty to hide sign-in with Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# «Что нового» after each deploy: @channel or -100…; the bot must be an admin of the channel.
TELEGRAM_CHANNEL_ID=
ANDROID_PACKAGE=
ANDROID_CERT_FINGERPRINTS='[]'
