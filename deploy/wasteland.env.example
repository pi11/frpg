# /etc/wasteland/wasteland.env — root:wasteland, mode 640. Read by systemd, not by a shell.
# PgBouncer (transaction pooling); use the direct PostgreSQL port if there is no PgBouncer.
DATABASE_URL=postgresql+asyncpg://wasteland:CHANGE_ME@127.0.0.1:6432/wasteland
PUBLIC_URL=https://game.example.com
CORS_ORIGINS='["https://game.example.com","https://localhost"]'
JWT_SECRET=
# resend, or disabled to hide sign-in by mail.
MAIL_BACKEND=resend
RESEND_API_KEY=
MAIL_FROM="Пустошь <login@game.example.com>"
# Leave all three empty to hide sign-in with Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ANDROID_PACKAGE=
ANDROID_CERT_FINGERPRINTS='[]'
