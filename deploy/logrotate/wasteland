# Copy to /etc/logrotate.d/wasteland-nginx. 14 days, as promised in the privacy policy.
/var/log/nginx/wasteland/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ ! -f /run/nginx.pid ] || kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
